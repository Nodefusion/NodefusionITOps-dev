{
  "name": "NodefusionITOps .NET Codespace",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",

  "features": {
    "ghcr.io/microsoft/codespace-features/external-repository:latest": {
      "gitProvider": "azuredevops",
      "cloneUrl": "https://dev.azure.com/Nodefusion/NodefusionITOps/_git/NodefusionITOps",
      "folder": "/workspaces/ado-source"
    }
  },

  "workspaceFolder": "/workspaces/ado-source",

  "remoteEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development"
  },

  "initializeCommand": "mkdir -p ${localWorkspaceFolder}/../ado-source",
  "postStartCommand": "external-git clone && external-git config && dotnet dev-certs https && echo $SECRETS_JSON > src/Nodefusion.NodefusionITOps/secrets.json && dotnet restore src/Nodefusion.NodefusionITOps/Nodefusion.NodefusionITOps.csproj",

  "forwardPorts": [5114, 7246],
  "portsAttributes": {
    "5114": {
      "visibility": "public"
    },
    "7246": {
      "protocol": "https",
      "visibility": "public"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  }
}
